    <string name="advice_garment_dark">அடர் அல்லது வண்ணம்</string>
    <string name="advice_from_measured">அளவிடப்பட்ட ஆடை நிறத்திலிருந்து அமைக்கப்பட்டது</string>
    <string name="advice_recommended">பரிந்துரைக்கப்படுகிறது</string>
