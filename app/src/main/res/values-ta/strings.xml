    <string name="advice_not_suitable">பொருத்தமில்லை</string>
    <string name="reason_fibre_suitable">துணி: %1$s பொருத்தமானதாகப் பட்டியலில் உள்ளது.</string>
    <string name="reason_fibre_not_suitable">துணி: %1$s பொருத்தமற்றதாகப் பட்டியலில் உள்ளது.</string>
    <string name="reason_fibre_caution">துணி எச்சரிக்கை: %1$s</string>
    <string name="reason_fibre_not_listed">துணி: %1$s இந்த முறையின் பொருத்தமான பட்டியலில் இல்லை.</string>
    <string name="reason_fibre_no_data">துணி: விதிகள் கோப்பில் நார் தரவு இல்லை.</string>
    <string name="reason_fibre_not_chosen">துணி தேர்வு செய்யப்படவில்லை, எனவே நார் சரிபார்க்கப்படவில்லை.</string>
    <string name="reason_artwork_solid_only">கலைப்படைப்பு: திட வடிவங்கள் தேவை; சாய்வு மற்றும் புகைப்படப் பகுதிகளை அச்சிட முடியாது.</string>
    <string name="reason_artwork_solid_preferred">கலைப்படைப்பு: திட வடிவங்களில் சிறந்தது; நுண்ணிய விவரம் மற்றும் தொனி இழக்கப்படும்.</string>
    <string name="reason_artwork_fits">கலைப்படைப்பு: இந்த வகைக்குப் பொருந்தும்.</string>
    <string name="reason_artwork_not_chosen">கலைப்படைப்பு வகை தேர்வு செய்யப்படவில்லை, எனவே சரிபார்க்கப்படவில்லை.</string>
    <string name="reason_garment_light_only">ஆடை: வெள்ளை அல்லது வெளிர் ஆடைகள் மட்டும்.</string>
    <string name="reason_garment_dark_only">ஆடை: அடர் அல்லது நடுத்தர சாயமிட்ட ஆடை தேவை.</string>
    <string name="reason_garment_caution">ஆடை எச்சரிக்கை: %1$s</string>
    <string name="reason_garment_note">ஆடை குறிப்பு: %1$s</string>
    <string name="reason_garment_not_chosen">ஆடை நிறம் தேர்வு செய்யப்படவில்லை, எனவே சரிபார்க்கப்படவில்லை.</string>
    <string name="advice_confidence">நம்பகத்தன்மை: %1$s</string>
    <string name="advice_confidence_none">நம்பகத்தன்மை: விதிகள் கோப்பில் கொடுக்கப்படவில்லை</string>
    <string name="advice_not_verified">தளத்தில் சரிபார்க்கப்படவில்லை</string>
    <string name="advice_risks">அபாயங்கள்</string>
    <string name="advice_disclaimer">பொது வர்த்தக மூலங்களின் அடிப்படையிலான விதி ஆலோசனை. உற்பத்திக்கு முன் ஸ்ட்ரைக்-ஆஃப் மூலம் உறுதிப்படுத்தவும்.</string>
